# Copy this file to .env and fill in your MySQL credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=job_tracker

# Used to sign flash messages; any random string works for local use.
SECRET_KEY=change-me
# Port 5000 is taken by AirPlay on macOS, so default to 5001.
PORT=5001
